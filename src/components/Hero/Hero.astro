---
/**
 * * Hero with background image + white logo watermark
 */

import Button from "@components/Button/Button.astro";
import heroImage from "@images/hero-bg-min.jpg";
import heroImageMobile from "@images/hero-bg-min.jpg";
import whiteLogo from "@images/paper-street-logo-white.png";
import { Image } from "astro:assets";
---

<section id="hero" class="relative z-10 flex min-h-[100lvh] w-full">
	<!-- background image -->
	<div class="absolute -z-10 h-full min-h-full w-full overflow-hidden">
		<div class="absolute inset-0 bg-black/10"></div>

		<Image
			src={heroImage}
			class="hidden h-auto min-h-full w-full object-cover object-bottom sm:block"
			alt="Hand-dyed warp on the loom"
			aria-hidden="true"
			loading="eager"
			height={1400}
		/>
		<Image
			src={heroImageMobile}
			class="h-auto min-h-full w-full object-cover sm:hidden"
			alt="Hand-dyed warp on the loom"
			aria-hidden="true"
			loading="eager"
			width={1200}
		/>
	</div>

	<!-- white logo watermark on hero -->
	<div class="pointer-events-none absolute top-20 right-4 z-10 md:top-32 md:right-12">
		<Image
			src={whiteLogo}
			alt="Paper Street Fibre Arts"
			class="h-16 w-auto opacity-90 drop-shadow-[0_2px_8px_rgba(0,0,0,0.35)] sm:h-20 md:h-44 lg:h-56"
			loading="eager"
			width={500}
		/>
	</div>

	<!-- hero items -->
	<div class="site-container relative w-full gap-10 py-44 text-center md:py-52 md:text-left">
		<!-- Hero text -->
		<div class="text-base-50 my-auto mr-auto max-w-[800px] flex-col">
			<h1
				class="font-heading-1 text-4xl font-semibold text-pretty drop-shadow-[0_2px_2px_rgba(0,0,0,0.4)] md:text-7xl md:leading-tight"
			>
				Custom handwoven heirlooms, made one thread at a time.
			</h1>
			<p
				class="mt-8 text-lg tracking-widest text-pretty drop-shadow-[0_1px_1px_rgba(0,0,0,0.2)] md:max-w-[550px] md:text-2xl"
			>
				Hand-dyed yarns and handwoven wraps, cowls, and shawls. Ten years of craft, made in Bowden, Alberta.
			</p>
			<div class="mt-10 flex flex-wrap justify-center gap-4 md:justify-start">
				<Button
					variant="ghost"
					arrow="right"
					href="/pricing/"
					class="pl-0 text-xl text-white drop-shadow-[0_1px_1px_rgba(0,0,0,0.2)] md:text-3xl"
				>
					See custom pricing
				</Button>
			</div>
		</div>
	</div>
</section>
